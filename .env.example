# APP: required on the Vercel production environment; real HTTPS origin, no path.
NEXT_PUBLIC_APP_URL=
# Only an actually owned/verified inbox. Without it, contact and kit forms are unavailable.
NEXT_PUBLIC_CONTACT_EMAIL=
# Enable indexing only after production domain and owner QA; previews stay noindex.
SITE_INDEXING_ENABLED=false
# Optional owner-QA mode: set true only for this branch's Vercel Preview environment.
# Disables AI, storage, email, analytics and external geocoding even if keys are inherited.
# Curated destinations and labelled personalized preparation checklists remain functional.
# Ignored on Production; it cannot bypass production validation.
FEMINTRAVEL_PREVIEW_CHECKLIST=false
# Owner-managed isolated Preview setup: docs/ISOLATED_PREVIEW_SETUP.md
# Branch overrides must use preview-only provider credentials, not inherited production keys.

# OPENAI: optional. Missing key gives an explicitly labelled preparation checklist.
OPENAI_API_KEY=
OPENAI_TRAVEL_MODEL=gpt-4o-mini
# AI requires Supabase rate limiting on production/preview builds.

# SUPABASE: server only. Apply versioned migrations before enabling features.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a random private value of at least 32 characters; never commit it.
RATE_LIMIT_SALT=

# GEOCODING: optional paid provider. Nominatim fallback uses cached, submitted searches.
MAPBOX_TOKEN=
# Optional public map token for close-up globe maps. Use an isolated Preview token first.
# Browser-visible pk.* token; do not use a secret server token here.
NEXT_PUBLIC_MAPBOX_TOKEN=

# EMAIL: optional one-time transactional delivery; verify sender/domain with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# AFFILIATES: complete partner-approved HTTPS URLs, optional {destination} placeholder.
# These values are intentionally public; never put secret partner API keys here.
NEXT_PUBLIC_AFFILIATES_ENABLED=false
NEXT_PUBLIC_AFFILIATE_HOTEL_URL=
NEXT_PUBLIC_AFFILIATE_FLIGHT_URL=
NEXT_PUBLIC_AFFILIATE_ACTIVITY_URL=
NEXT_PUBLIC_AFFILIATE_INSURANCE_URL=

# SOCIAL: only real account URLs. Empty platforms are not rendered.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=

# ANALYTICS: optional limited first-party events. No third-party trackers or cookies.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# PREMIUM: reserved, disabled. No payment/checkout implementation exists.
NEXT_PUBLIC_PREMIUM_ENABLED=false
